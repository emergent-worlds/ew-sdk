{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kestrel Yards",
  "version": "1.0.0",
  "identifier": "com.emergentworldslabs.kestrel-yards",
  "build": { "frontendDist": "../build/web" },
  "app": {
    "windows": [{ "label": "main", "title": "Kestrel Yards", "width": 1000, "height": 700 }],
    "security": { "csp": { "default-src": "'self'", "script-src": "'self'", "worker-src": "'self' blob:", "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:*", "style-src": "'self'", "object-src": "'none'", "base-uri": "'none'" } }
  },
  "bundle": { "active": true, "targets": "all" }
}
